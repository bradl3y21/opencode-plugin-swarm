{
  "name": "opencode-quorum",
  "version": "1.1.0",
  "description": "Assemble a quorum of OpenCode models for one task — mixture, debate, divide, relay and vote — with an optional desktop dashboard.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/bradl3y21/opencode-quorum.git"
  },
  "homepage": "https://github.com/bradl3y21/opencode-quorum#readme",
  "bugs": {
    "url": "https://github.com/bradl3y21/opencode-quorum/issues"
  },
  "type": "module",
  "main": "./index.ts",
  "exports": {
    ".": "./index.ts",
    "./tui": "./tui.ts",
    "./rpc": "./rpc.ts"
  },
  "files": [
    "*.ts",
    "desktop/*.mjs",
    "desktop/quorum-panel.js",
    "docs",
    "skills",
    "quorum.example.json",
    "README.md",
    "LICENSE"
  ],
  "keywords": [
    "opencode",
    "opencode-plugin",
    "quorum",
    "multi-model",
    "mixture-of-agents",
    "consensus",
    "debate",
    "llm"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "selftest": "node desktop/selftest.mjs",
    "panel:install": "node desktop/install.mjs",
    "panel:uninstall": "node desktop/install.mjs --uninstall",
    "panel:verify": "node desktop/verify.mjs",
    "harness": "node desktop/harness.mjs"
  }
}
